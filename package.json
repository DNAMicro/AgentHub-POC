{
  "name": "agenthub-poc",
  "version": "1.0.0",
  "description": "AgentHub-POC: agents that talk over the real A2A protocol through a university hub, with A2UI interfaces and Claude Haiku 5.5. Localhost proof of concept.",
  "scripts": {
    "test": "HUB_URL=http://127.0.0.1:9 node --test --test-reporter=spec test/",
    "tutor": "node src/tutor-agent.js",
    "student": "node src/student-agent.js",
    "ui": "npm run build:ui && STUDENT_MODE=mock node src/ui-server.js",
    "build:ui": "esbuild src/browser/a2ui-entry.js --bundle --format=esm --target=es2022 --minify --legal-comments=linked --outfile=public/vendor/a2ui.js && esbuild src/browser/ag-ui-entry.js --bundle --format=esm --target=es2022 --minify --legal-comments=linked --outfile=public/vendor/ag-ui.js",
    "tutor:mock": "TUTOR_MODE=mock node src/tutor-agent.js",
    "tutor:live": "TUTOR_MODE=live node src/tutor-agent.js",
    "smoke:live": "node scripts/live-smoke.js",
    "library": "node src/library-agent.js",
    "library:live": "LIBRARY_MODE=live node src/library-agent.js",
    "professor": "node src/professor-agent.js",
    "professor:live": "PROFESSOR_MODE=live node src/professor-agent.js",
    "ui:live": "npm run build:ui && STUDENT_MODE=live node src/ui-server.js",
    "eval:live": "node scripts/live-eval.js",
    "hub": "ROUTER_MODE=mock node src/hub-agent.js",
    "hub:live": "ROUTER_MODE=live node src/hub-agent.js",
    "hub:direct": "node src/hub-agent.js",
    "demo": "npm run build:ui && node scripts/start-all.js",
    "demo:live": "npm run build:ui && DEMO_MODE=live node scripts/start-all.js",
    "demo:reset-loans": "node scripts/demo/reset-loans.js",
    "demo:build": "node scripts/demo/build-walkthrough.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@a2ui/lit": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/client": "1.0.3",
    "@ag-ui/core": "1.0.3",
    "@ag-ui/encoder": "1.0.3",
    "@anthropic-ai/sdk": "1.3.0",
    "ajv": "8.20.0",
    "express": "5.3.0",
    "lit": "3.3.3",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2"
  }
}
