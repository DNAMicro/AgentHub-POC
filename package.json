{
  "name": "a2a-spike",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "node --test --test-reporter=spec test/",
    "tutor": "node src/tutor-agent.js",
    "student": "node src/student-agent.js",
    "ui": "npm run build:ui && ROUTER_MODE=mock node src/ui-server.js",
    "build:ui": "esbuild src/browser/a2ui-entry.js --bundle --format=esm --target=es2022 --minify --legal-comments=linked --outfile=public/vendor/a2ui.js",
    "tutor:mock": "TUTOR_MODE=mock node src/tutor-agent.js",
    "tutor:live": "TUTOR_MODE=live node src/tutor-agent.js",
    "smoke:live": "node scripts/live-smoke.js",
    "library": "node src/library-agent.js",
    "library:live": "LIBRARY_MODE=live node src/library-agent.js",
    "ui:live": "npm run build:ui && ROUTER_MODE=live node src/ui-server.js",
    "ui:direct": "npm run build:ui && node src/ui-server.js",
    "eval:live": "node scripts/live-eval.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@a2ui/lit": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "@anthropic-ai/sdk": "1.3.0",
    "express": "5.3.0",
    "lit": "3.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2"
  }
}
